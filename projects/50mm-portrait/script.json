        ]
      },
      "lines": [ "贴近拍特写时，近处的眼睛清楚了，鼻尖和远处的眼睛却已经开始发虚。" ] },
    { "id": "c1-rule", "type": "photo", "chapter": 1,
      "params": {
        "img": "half", "kb": [1.12, 0.6, 0.45, 1.02, 0.6, 0.45], "dimSide": "left",
        "cards": [
          { "at": 0, "kicker": "CLOSE-UP", "title": "特写  F2 – F2.8", "body": "对焦永远放在离镜头更近的那只眼睛" },
          { "at": 1, "kicker": "HALF BODY", "title": "半身  F1.2 · 2.5m", "body": "整张脸都在焦内，背景彻底化开" }
